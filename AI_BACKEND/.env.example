# Hugging Face token: create a token with inference permission and paste it here.
HF_TOKEN=hf_REPLACE_WITH_YOUR_TOKEN
HF_PROVIDER=auto
HF_INFERENCE_TIMEOUT_SECONDS=30
HF_SCAM_MODEL=rehan-ml/scamshield-scam-detector
HF_ASR_MODEL=openai/whisper-large-v3-turbo
HF_CALL_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
FRAUDSHIELD_INTERNAL_SECRET=fraudshield-local-internal-dev
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
